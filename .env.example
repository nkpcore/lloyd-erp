# ==============================================================
# Lloyd ERP Fleet Governance — Production Environment Variables
# ==============================================================

# 1. Private GitHub Releases & OTA Proxy (Optional but Recommended)
# Generate at: https://github.com/settings/tokens (Scope: repo or public_repo)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPOSITORY=nkpcore/lloyd-erp

# 2. Vercel KV / Upstash Redis Persistent Storage (Auto-populated by Vercel Storage)
# Created in Vercel Dashboard -> Storage -> Create KV
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_token_here
