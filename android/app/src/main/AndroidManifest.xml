<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Custom Signature Permission for Widget IPC Security (SEC-FINDING-006) -->
    <permission
        android:name="com.lloyd.attendance.permission.WIDGET_REFRESH"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.lloyd.attendance.permission.WIDGET_REFRESH" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_school"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_school"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LloydAttendance">

        <!-- Main Jetpack Compose Screen -->
        <activity
            android:name=".ui.MainComposeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy View Activity (Deprecated) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Login Screen -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Screen Widget Receiver (System AppWidget update only) -->
        <receiver
            android:name=".widget.AttendanceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info" />
        </receiver>

        <!-- Internal Refresh Receiver protected with signature permission & unexported (SEC-FINDING-006) -->
        <receiver
            android:name=".widget.AttendanceWidgetRefreshReceiver"
            android:exported="false"
            android:permission="com.lloyd.attendance.permission.WIDGET_REFRESH">
            <intent-filter>
                <action android:name="com.lloyd.attendance.ACTION_REFRESH_WIDGET" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for OTA In-App Updates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
