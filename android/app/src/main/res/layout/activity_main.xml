<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar / Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_dark_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- Profile Avatar Circle -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_button"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_school"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Student Name & Section Telemetry -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_main_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="NIKHIL KUMAR PANDEY"
                    android:textColor="@color/md_theme_dark_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Connectivity Status Pill -->
                <LinearLayout
                    android:id="@+id/pill_connectivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_connectivity"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/ic_pulse_dot" />

                    <TextView
                        android:id="@+id/tv_main_student_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Live Sync • Section A-1"
                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Privacy / Stealth Eye Toggle -->
            <ImageButton
                android:id="@+id/btn_main_stealth"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_pill"
                android:contentDescription="Privacy Mode"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_visibility"
                app:tint="@color/md_theme_dark_onSurfaceVariant" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btn_main_sync"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_pill"
                android:contentDescription="Refresh Data"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                app:tint="@color/md_theme_dark_onSurfaceVariant" />

            <!-- Logout Button -->
            <ImageButton
                android:id="@+id/btn_main_logout"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_widget_pill"
                android:contentDescription="Sign Out"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logout"
                app:tint="@color/md_theme_dark_onSurfaceVariant" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_dark_outlineVariant" />

        <!-- Swipe Refresh wrapping the 4 views -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <FrameLayout
                    android:id="@+id/container_pages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- ========================================== -->
                    <!-- TAB 1: DASHBOARD -->
                    <!-- ========================================== -->
                    <LinearLayout
                        android:id="@+id/section_dashboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- Hero Attendance Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainerHigh"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/md_theme_dark_outlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Overall Attendance"
                                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_main_last_updated"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Just now"
                                        android:textColor="@color/text_muted"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <!-- Big Percentage & Badge -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_main_percentage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="60.8%"
                                        android:textColor="@color/status_danger"
                                        android:textSize="44sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="16dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tv_main_badge"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:background="@drawable/bg_tag_absent"
                                            android:paddingStart="10dp"
                                            android:paddingTop="3dp"
                                            android:paddingEnd="10dp"
                                            android:paddingBottom="3dp"
                                            android:text="SHORTAGE (60.8%)"
                                            android:textColor="@color/status_danger_text"
                                            android:textSize="11sp"
                                            android:textStyle="bold" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="6dp"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <ImageView
                                                android:id="@+id/iv_main_bunk_icon"
                                                android:layout_width="14dp"
                                                android:layout_height="14dp"
                                                android:src="@drawable/ic_alert"
                                                app:tint="@color/status_danger_text" />

                                            <TextView
                                                android:id="@+id/tv_main_bunk_advice"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="6dp"
                                                android:text="Need 42 to reach 75%"
                                                android:textColor="@color/md_theme_dark_onSurface"
                                                android:textSize="12sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- 3 Metric Tiles -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:orientation="horizontal">

                                    <!-- Attended -->
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_widget_pill"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="12dp">

                                        <TextView
                                            android:id="@+id/tv_stat_present"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="45"
                                            android:textColor="@color/status_safe"
                                            android:textSize="20sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Attended"
                                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <!-- Absent -->
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_widget_pill"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="12dp">

                                        <TextView
                                            android:id="@+id/tv_stat_absent"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="29"
                                            android:textColor="@color/status_danger"
                                            android:textSize="20sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Missed"
                                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <!-- Total -->
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_widget_pill"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="12dp">

                                        <TextView
                                            android:id="@+id/tv_stat_total"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="74"
                                            android:textColor="@color/md_theme_dark_onSurface"
                                            android:textSize="20sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="Total"
                                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Live Today's Schedule in NB-101 Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_live_glance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/md_theme_dark_outlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_glance_badge_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Today in Room NB-101"
                                        android:textColor="@color/md_theme_dark_primary"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <Space
                                        android:layout_width="0dp"
                                        android:layout_height="1dp"
                                        android:layout_weight="1" />

                                    <LinearLayout
                                        android:id="@+id/badge_glance_live"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_live_pill"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingStart="8dp"
                                        android:paddingTop="2dp"
                                        android:paddingEnd="8dp"
                                        android:paddingBottom="2dp">

                                        <ImageView
                                            android:id="@+id/iv_glance_pulse"
                                            android:layout_width="6dp"
                                            android:layout_height="6dp"
                                            android:src="@drawable/ic_pulse_dot" />

                                        <TextView
                                            android:id="@+id/tv_glance_live_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="5dp"
                                            android:text="LIVE NOW"
                                            android:textColor="@color/status_safe_text"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_glance_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Applied Mathematics-I"
                                    android:textColor="@color/md_theme_dark_onSurface"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_glance_details"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Period II (09:50 - 10:40) • Dr. Digvijay Singh (DDS)"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- ========================================== -->
                    <!-- TAB 2: SCHEDULE (SECTION A-1) -->
                    <!-- ========================================== -->
                    <LinearLayout
                        android:id="@+id/section_schedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Section Header Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_schedule_section_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Section A-1 • Room NB-101"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_widget_pill"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="Sem 01"
                                android:textColor="@color/md_theme_dark_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Day Selector Buttons (Mon - Sat) -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="14dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btn_day_mon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_selected"
                                    android:text="Mon"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_day_tue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="Tue"
                                    android:textAllCaps="false"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_day_wed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="Wed"
                                    android:textAllCaps="false"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_day_thu"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="Thu"
                                    android:textAllCaps="false"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_day_fri"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="Fri"
                                    android:textAllCaps="false"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/btn_day_sat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_chip_unselected"
                                    android:text="Sat (Test)"
                                    android:textAllCaps="false"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Dynamic Timeline Container -->
                        <LinearLayout
                            android:id="@+id/container_schedule_periods"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <!-- ========================================== -->
                    <!-- TAB 3: ATTENDANCE LOG -->
                    <!-- ========================================== -->
                    <LinearLayout
                        android:id="@+id/section_classes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Status Filter Tabs -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/tab_filter_all"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_selected"
                                android:text="All (74)"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/tab_filter_present"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_unselected"
                                android:text="Present (45)"
                                android:textAllCaps="false"
                                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/tab_filter_absent"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_unselected"
                                android:text="Absent (29)"
                                android:textAllCaps="false"
                                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Month Filter Chips -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Select Month"
                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/container_month_chips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <!-- Subject Filter Chips -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Select Subject"
                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/container_subject_chips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <!-- Count Summary -->
                        <TextView
                            android:id="@+id/tv_filter_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp"
                            android:text="Showing all 74 classes"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <!-- Dynamic Classes List -->
                        <LinearLayout
                            android:id="@+id/container_periods"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- ========================================== -->
                    <!-- TAB 4: SIMULATOR & ANALYTICS -->
                    <!-- ========================================== -->
                    <LinearLayout
                        android:id="@+id/section_simulator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Simulator Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainerHigh"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/md_theme_dark_outlineVariant"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Attendance &amp; Bunk Simulator"
                                    android:textColor="@color/md_theme_dark_onSurface"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="See your recalculated percentage before skipping or attending upcoming lectures:"
                                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                    android:textSize="12sp" />

                                <!-- Target Selector Chips -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/chip_target_75"
                                        android:layout_width="0dp"
                                        android:layout_height="34dp"
                                        android:layout_marginEnd="6dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_chip_selected"
                                        android:text="75% Mandatory"
                                        android:textAllCaps="false"
                                        android:textColor="@color/white"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <Button
                                        android:id="@+id/chip_target_80"
                                        android:layout_width="0dp"
                                        android:layout_height="34dp"
                                        android:layout_weight="1"
                                        android:background="@drawable/bg_chip_unselected"
                                        android:text="80% Safety Buffer"
                                        android:textAllCaps="false"
                                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Projected Percentage Gauge -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_sim_projected_pct"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="60.8%"
                                        android:textColor="@color/status_safe"
                                        android:textSize="36sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_sim_status_note"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_weight="1"
                                        android:text="Current Status"
                                        android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- Slider -->
                                <SeekBar
                                    android:id="@+id/sb_sim_delta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:max="25"
                                    android:progress="10" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="-10 Missed"
                                        android:textColor="@color/status_danger"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_sim_current_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Current (0)"
                                        android:textColor="@color/white"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:gravity="end"
                                        android:text="+15 Attended"
                                        android:textColor="@color/status_safe"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Subject-Wise Analytics Header -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="8dp"
                            android:text="Subject Breakdown &amp; Safety Margins"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Subject Analytics Items Container -->
                        <LinearLayout
                            android:id="@+id/container_subject_items"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </FrameLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_dark_outlineVariant" />

        <!-- Material 3 Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/md_theme_dark_surfaceContainerLowest"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/selector_nav_tint"
            app:itemTextColor="@color/selector_nav_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
