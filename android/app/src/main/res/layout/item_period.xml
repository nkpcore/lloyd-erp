<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp"
    android:baselineAligned="false">

    <!-- Left Vertical Accent Bar (Green / Red indicator) -->
    <View
        android:id="@+id/view_period_indicator"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#10B981" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Lecture tag, Date/Time, and Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_period_lecture_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="LEC #6"
                android:textColor="#C7D2FE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_period_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Thursday, Oct 01"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:singleLine="true" />

            <!-- Status Tag -->
            <TextView
                android:id="@+id/tv_period_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_present"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="PRESENT"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subject Name -->
        <TextView
            android:id="@+id/tv_period_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fundamentals of Electronics Engineering"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Bottom Row: Faculty and Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_period_faculty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Faculty: Dr. Ridhima"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_period_marked_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:52 AM"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
