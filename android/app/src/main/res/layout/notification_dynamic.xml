<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Left Status Circle / Pill Icon -->
    <FrameLayout
        android:id="@+id/notif_icon_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_pill">

        <ImageView
            android:id="@+id/notif_status_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            android:tint="#84A59D"
            tools:ignore="UseAppTint" />
    </FrameLayout>

    <!-- Center Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_header_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARKED PRESENT"
                android:textColor="#84A59D"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#8E9099"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/notif_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just now"
                android:textColor="#8E9099"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E3E2E6"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_teacher_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#C4C7C5"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Live Overall Status Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_pill"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/notif_overall_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85.4%"
            android:textColor="#F6BD60"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_overall_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVERALL"
            android:textColor="#8E9099"
            android:textSize="8sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />
    </LinearLayout>

</LinearLayout>
