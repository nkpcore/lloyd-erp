<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP for local captive portal gateway redirects and connectivity probes -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Only trust verified system CAs; ignore untrusted/user-installed proxies -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Strictly disallow any cleartext traffic to the official ERP domain and APIs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">erp.lloydcollege.in</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
